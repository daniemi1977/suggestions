# Configuration File Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file with real API keys to git!

# ===========================================
# API KEYS CONFIGURATION
# ===========================================

# YouTube Data API v3
# Get your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIza_your_youtube_api_key_here

# SupaData Transcription API
# Get your key from: https://supadata.ai
SUPADATA_API_KEY=sd_your_supadata_api_key_here

# OpenAI API
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# ===========================================
# CHANNEL CONFIGURATION
# ===========================================

# Channel Identity
CHANNEL_NAME=Your Channel Name
CHANNEL_OWNER=Your Name
CHANNEL_YOUTUBE_ID=UCxxxxxxxxxxxxxxxxx
CHANNEL_YOUTUBE_HANDLE=@yourchannelhandle
CHANNEL_RSS_FEED=https://www.youtube.com/feeds/videos.xml?channel_id=UCxxxxxxxxxxxxxxxxx

# Channel Description
CHANNEL_DESCRIPTION=Your channel description here

# Channel Themes (comma-separated)
CHANNEL_THEMES=Theme 1 – Description,Theme 2 – Description,Theme 3 – Description

# Content Style
CONTENT_TONE=Describe your content tone here (e.g., Professional, casual, technical)
CONTENT_LANGUAGE=it

# ===========================================
# SPONSOR CONFIGURATION
# ===========================================

SPONSOR_ENABLED=false
SPONSOR_NAME=Your Sponsor Name
SPONSOR_DESCRIPTION=Your sponsor description here
SPONSOR_LINK=https://example.com/sponsor-link
SPONSOR_CTA=Visit sponsor website

# ===========================================
# DONATIONS
# ===========================================

DONATIONS_ENABLED=false
DONATIONS_PLATFORM=PayPal
DONATIONS_LINK=https://paypal.me/yourhandle
DONATIONS_MESSAGE=Support the channel by donating at this link
DONATIONS_THANKS=Thank you for your support!

# ===========================================
# SOCIAL MEDIA
# ===========================================

SOCIAL_TELEGRAM=https://t.me/yourchannel
SOCIAL_FACEBOOK=https://facebook.com/yourchannel
SOCIAL_INSTAGRAM=https://instagram.com/yourchannel
SOCIAL_TWITTER=https://twitter.com/yourchannel
SOCIAL_TIKTOK=https://tiktok.com/@yourchannel
SOCIAL_LINKEDIN=https://linkedin.com/company/yourchannel

# ===========================================
# CONTACT INFORMATION
# ===========================================

CONTACT_EMAIL=your.email@example.com
CONTACT_WEBSITE=https://www.yourchannel.com
CONTACT_PHONE=+1234567890

# ===========================================
# ADDITIONAL LINKS
# ===========================================

LINK_PATREON=
LINK_SHOP=
LINK_NEWSLETTER=
LINK_COURSES=

# ===========================================
# PRODUCTION CREDITS
# ===========================================

PRODUCTION_CREDITS=Your Production Team Name

# ===========================================
# BRANDING
# ===========================================

BRANDING_TAGLINE=Your channel tagline
BRANDING_HASHTAGS=#YourChannel,#YourBrand

# ===========================================
# AUTO-IMPORT SETTINGS
# ===========================================

AUTO_IMPORT_ENABLED=false
AUTO_IMPORT_CHECK_INTERVAL=60
AUTO_IMPORT_MAX_VIDEOS=10
AUTO_IMPORT_EMAIL_NOTIFICATIONS=false
AUTO_IMPORT_NOTIFICATION_EMAIL=your.email@example.com

# ===========================================
# PROCESSING SETTINGS
# ===========================================

TRANSCRIPT_MODE=auto
TRANSCRIPT_TIMEOUT=300
MAX_RETRY_ATTEMPTS=3
BATCH_SIZE=5
AUTO_PUBLISH=false

# ===========================================
# CATEGORY MAPPING (YouTube ID => WordPress ID)
# ===========================================

# People & Blogs => Misteri (example: 5)
CATEGORY_MAPPING_22=5
# Music => Musica (example: 3)
CATEGORY_MAPPING_10=3
# Entertainment => Esoterismo (example: 7)
CATEGORY_MAPPING_24=7
# News & Politics => Geopolitica (example: 8)
CATEGORY_MAPPING_25=8
# Science & Technology => Scienza (example: 9)
CATEGORY_MAPPING_28=9

DEFAULT_CATEGORY=1
